{
  "name": "webdev-sync",
  "version": "0.1.0",
  "description": "123 网盘 WebDAV 文档同步助手",
  "author": "Webdev Sync",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist": "pnpm run build && electron-builder --win",
    "dist:dir": "pnpm run build && electron-builder --win dir",
    "dist:installer": "pnpm run build && electron-builder --win nsis",
    "preview": "vite preview"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "webdav": "^5.8.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "appId": "com.webdev.sync",
    "productName": "Webdev Sync",
    "artifactName": "Webdev-Sync-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Webdev Sync"
    },
    "portable": {
      "artifactName": "Webdev-Sync-${version}-portable.${ext}"
    }
  }
}
